{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and crypto wallet balance details",
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "maxLength": 64
        },
        "balanceUsdt": {
          "type": "number"
        },
        "balanceBnb": {
          "type": "number"
        },
        "totalMined": {
          "type": "number"
        },
        "referralCode": {
          "type": "string",
          "maxLength": 32
        },
        "referredBy": {
          "type": "string",
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user", "moderator"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "frozen", "banned"]
        },
        "createdAt": {
          "type": "string"
        },
        "lastActive": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["address", "balanceUsdt", "role", "status"]
    },
    "MiningNode": {
      "title": "MiningNode",
      "description": "Mining hardware rig and validator node telemetry data",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "region": {
          "type": "string",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["mining", "idle", "syncing", "stopped"]
        },
        "hashrate": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        },
        "shareAcceptance": {
          "type": "number"
        },
        "fanSpeed": {
          "type": "number"
        },
        "powerUsage": {
          "type": "number"
        },
        "uptimeDays": {
          "type": "number"
        },
        "algorithm": {
          "type": "string",
          "maxLength": 50
        },
        "userAddress": {
          "type": "string",
          "maxLength": 64
        },
        "costUsdt": {
          "type": "number"
        }
      },
      "required": ["id", "name", "status", "hashrate"]
    },
    "RewardTransaction": {
      "title": "RewardTransaction",
      "description": "Mining epoch reward and payout ledger entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "txHash": {
          "type": "string",
          "maxLength": 128
        },
        "rewardSource": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "maxLength": 16
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Confirmed", "Pending"]
        },
        "epoch": {
          "type": "number"
        },
        "userAddress": {
          "type": "string",
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["id", "amount", "currency", "status"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global cluster parameters and domain route mappings",
      "type": "object",
      "properties": {
        "turboMultiplier": {
          "type": "number"
        },
        "dailyYieldPercent": {
          "type": "number"
        },
        "maintenanceMode": {
          "type": "boolean"
        },
        "stratumPoolUrl": {
          "type": "string",
          "maxLength": 200
        },
        "bscContractAddress": {
          "type": "string",
          "maxLength": 100
        },
        "minWithdrawalUsdt": {
          "type": "number"
        },
        "autoPayoutEnabled": {
          "type": "boolean"
        },
        "primaryDomain": {
          "type": "string",
          "maxLength": 100
        },
        "protocolUrl": {
          "type": "string",
          "maxLength": 200
        },
        "apiBaseUrl": {
          "type": "string",
          "maxLength": 200
        },
        "docsUrl": {
          "type": "string",
          "maxLength": 200
        },
        "rpcUrl": {
          "type": "string",
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["maintenanceMode"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and governance operational log record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "adminUser": {
          "type": "string",
          "maxLength": 64
        },
        "action": {
          "type": "string",
          "maxLength": 100
        },
        "target": {
          "type": "string",
          "maxLength": 100
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": ["id", "adminUser", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User accounts and wallet balances"
    },
    "/nodes/{nodeId}": {
      "schema": "MiningNode",
      "description": "Mining nodes and cluster validator units"
    },
    "/transactions/{txId}": {
      "schema": "RewardTransaction",
      "description": "Rewards and payouts transactions ledger"
    },
    "/settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Cluster operational config and spikenodes.com domain bindings"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative events and audit trail"
    }
  }
}
