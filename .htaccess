# ==============================================================================
# SPIKE Nodes (spikenodes.com) — Hostinger Git Auto-Deployment Root Configuration
# ==============================================================================

DirectoryIndex index.php prod/index.html dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Allow direct access to files in prod/ and public/
  RewriteRule ^prod/ - [L]
  RewriteRule ^public/ - [L]

  # 3. If file exists inside prod/, rewrite directly (e.g. /assets/xxx.js -> /prod/assets/xxx.js)
  RewriteCond %{DOCUMENT_ROOT}/prod%{REQUEST_URI} -f
  RewriteRule ^(.*)$ prod/$1 [L,QSA]

  # 4. If file exists directly (e.g. images, favicon), let it serve
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Route root and all SPA page requests through index.php (which auto-loads prod/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# MIME type enforcement for Vite ESM chunks & modern Web3 assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Security and caching headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Access-Control-Allow-Origin "*"

  # Cache Vite hashed assets for maximum speed
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|js|mjs|css|webp|woff|woff2|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML files should always check for updates
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
